{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token", "token": "${OPENCLAW_GATEWAY_TOKEN}" }
  },
  "agents": {
    "defaults": {
      "workspace": "/tmp/niuma-workspace",
      "model": { "primary": "niuma-platform/ep-test" }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "niuma-platform": {
        "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
        "apiKey": "${NIUMA_MODEL_ACCESS_TOKEN}",
        "api": "openai-completions",
        "models": [
          {
            "id": "ep-test",
            "name": "火山方舟模型",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 128000,
            "maxTokens": 16000
          }
        ]
      }
    }
  },
  "tools": { "profile": "coding" }
}
