NODE_ENV=development
HOST=127.0.0.1
PORT=4310
DATABASE_URL_FILE=/run/secrets/database_url
PUBLIC_API_URL=https://api.alipayclaw.cn

# 平台模型只在服务端配置。生产优先挂载 Secret 文件，不要把真实值写进 env 文件。
NIUMA_ARK_API_KEY_FILE=/run/secrets/niuma_ark_api_key
NIUMA_PLATFORM_MODEL_ID=doubao-seed-2-1-turbo-260628
NIUMA_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 管理接口凭证只从服务端 Secret 读取，不进入客户端或前端构建。
NIUMA_ADMIN_TOKEN_FILE=/run/secrets/niuma_admin_token

# Telegram 未创建前保持整组为空；启用时三个字段必须同时提供。
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
